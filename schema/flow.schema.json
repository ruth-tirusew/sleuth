{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleuth.local/schema/flow.schema.json",
  "title": "Sleuth flow spec v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "finally": {
      "description": "Cleanup nodes: run after every main node has finished, pass or fail, one at a time, under their own time limit. A node whose dependencies did not pass is skipped. API-only: request, transform, or a poll on a request.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "params": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "default": {}
            }
          }
        ]
      },
      "description": "Inputs this flow takes when another flow runs it as a subflow. A param with a default is optional."
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "description": "Values handed back to the calling flow as nodes.<id>.out.<name>; templates, evaluated once every node has finished."
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "request",
            "assertion",
            "transform",
            "poll",
            "db",
            "flow"
          ]
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "assert": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "transform": {
          "type": "object",
          "required": [
            "set"
          ],
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        "contract": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "required": [
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "on_violation": {
                  "enum": [
                    "fail",
                    "warn"
                  ]
                }
              }
            }
          ],
          "description": "Request nodes, and poll nodes that poll a request: validate the call against the OpenAPI document named under contracts: in the env file."
        },
        "poll": {
          "type": "object",
          "required": [
            "until"
          ],
          "additionalProperties": false,
          "description": "Repeat the request until every `until` check passes or `timeout` elapses.",
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "until": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            },
            "timeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$"
            },
            "backoff": {
              "type": "object",
              "additionalProperties": false,
              "description": "Grow the delay between attempts: interval * factor^(attempt-1), capped at max, spread by +/- jitter.",
              "properties": {
                "factor": {
                  "type": "number",
                  "minimum": 1
                },
                "max": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m)$"
                },
                "jitter": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "db": {
              "$ref": "#/$defs/db"
            }
          },
          "oneOf": [
            {
              "required": [
                "request"
              ]
            },
            {
              "required": [
                "db"
              ]
            }
          ]
        },
        "db": {
          "$ref": "#/$defs/db"
        },
        "flow": {
          "type": "string",
          "description": "Path of another flow file, relative to this one and inside the top-level flow's directory (kind: flow)."
        },
        "params": {
          "type": "object",
          "description": "Values the subflow is called with; strings may contain templates (kind: flow)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "request"
              }
            }
          },
          "then": {
            "required": [
              "request"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assertion"
              }
            }
          },
          "then": {
            "required": [
              "assert"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "transform"
              }
            }
          },
          "then": {
            "required": [
              "transform"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poll"
              }
            }
          },
          "then": {
            "required": [
              "poll"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "db"
              }
            }
          },
          "then": {
            "required": [
              "db"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flow"
              }
            }
          },
          "then": {
            "required": [
              "flow"
            ]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$"
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "minProperties": 2,
      "properties": {
        "path": {
          "type": "string"
        },
        "equals": {},
        "contains": {},
        "exists": {
          "type": "boolean"
        },
        "matches": {
          "type": "string"
        },
        "gt": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "db": {
      "type": "object",
      "required": [
        "connection"
      ],
      "additionalProperties": false,
      "description": "Read-only database query. postgres (default): query+args. mongo: database+collection with filter/sort/projection or pipeline. Rows: nodes.<id>.rows, nodes.<id>.row_count.",
      "properties": {
        "type": {
          "enum": [
            "postgres",
            "mongo"
          ]
        },
        "connection": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "args": {
          "type": "array"
        },
        "database": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "filter": {
          "type": "object"
        },
        "projection": {
          "type": "object"
        },
        "pipeline": {
          "type": "array"
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": {
              "enum": [
                1,
                -1
              ]
            }
          }
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$"
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "mongo"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "database",
              "collection"
            ]
          },
          "else": {
            "required": [
              "query"
            ]
          }
        }
      ]
    }
  }
}
